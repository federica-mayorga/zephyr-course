config BOARD_OUR_BOARD
	select SOC_NRF54L05_CPUAPP if BOARD_OUR_BOARD_NRF54L05_CPUAPP
	select SOC_NRF54L10_CPUAPP if BOARD_OUR_BOARD_NRF54L10_CPUAPP || BOARD_OUR_BOARD_NRF54L10_CPUAPP_NS
	select SOC_NRF54L15_CPUAPP if BOARD_OUR_BOARD_NRF54L15_CPUAPP || BOARD_OUR_BOARD_NRF54L15_CPUAPP_NS
	select SOC_NRF54L15_CPUFLPR if BOARD_OUR_BOARD_NRF54L15_CPUFLPR || \
					    BOARD_OUR_BOARD_NRF54L15_CPUFLPR_XIP
